#!/usr/bin/env bash
# ==============================================================================
#  🌸 moe-game-launcher 🌸
#  Linux 游戏启动与混合显卡调度工具 · 支持 Gamescope 144Hz 锁帧与性能监控
# ==============================================================================

set -e

VERSION="1.0.0"

# 颜色代码
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_PINK="\033[38;2;243;139;168m"
C_PURPLE="\033[38;2;203;166;247m"
C_BLUE="\033[38;2;137;180;250m"
C_CYAN="\033[38;2;137;220;235m"
C_GREEN="\033[38;2;166;227;161m"
C_YELLOW="\033[38;2;249;226;175m"
C_RED="\033[38;2;243;139;168m"
C_GRAY="\033[38;2;108;112;134m"

print_banner() {
    echo -e "${C_PINK}"
    cat << 'EOF'
      /\_/\   
     ( o.o )  ✨ moe-game-launcher ✨
      > ^ <   Linux 游戏启动与混合显卡调度工具
EOF
    echo -e "${C_RESET}"
}

usage() {
    print_banner
    echo -e "${C_BOLD}用法:${C_RESET}"
    echo -e "  ${C_CYAN}moe-game run${C_RESET} [选项] <游戏.exe 或 Linux游戏命令> [参数...]"
    echo -e "  ${C_CYAN}moe-game doctor${C_RESET}                检测系统的游戏环境与显卡驱动状态"
    echo -e "  ${C_CYAN}moe-game hud-install${C_RESET}           安装 MangoHud 性能监控主题配置"
    echo -e "  ${C_CYAN}moe-game steam-options${C_RESET}         生成适用于 Steam 启动项的独显参数"
    echo ""
    echo -e "${C_BOLD}运行选项 (run options):${C_RESET}"
    echo -e "  ${C_PINK}-n, --nvidia${C_RESET}         使用 NVIDIA 独立显卡渲染 (Prime Offload, 默认开启)"
    echo -e "  ${C_BLUE}-g, --gamescope${C_RESET}      使用 Gamescope 运行 (匹配 1920x1080 144Hz + FSR 锐化)"
    echo -e "  ${C_YELLOW}-m, --hud${C_RESET}            挂载 MangoHud 帧率与硬件状态监控"
    echo -e "  ${C_PURPLE}-l, --lsfg${C_RESET}           启用 Lossless Scaling 补帧环境变量"
    echo -e "  ${C_GREEN}-w, --wine-only${C_RESET}      纯 Wine 运行 (不使用 Proton)"
    echo -e "  ${C_GRAY}-h, --help${C_RESET}           显示本帮助菜单"
    echo ""
    echo -e "${C_BOLD}使用示例:${C_RESET}"
    echo -e "  ${C_GRAY}# 使用独显 + MangoHud 运行 Windows 游戏 exe:${C_RESET}"
    echo -e "  ${C_GREEN}moe-game run -m /path/to/game.exe${C_RESET}"
    echo ""
    echo -e "  ${C_GRAY}# 使用 Gamescope 144Hz 锁帧 + FSR 锐化 + 独显运行:${C_RESET}"
    echo -e "  ${C_GREEN}moe-game run -g -m /path/to/game.exe${C_RESET}"
}

cmd_doctor() {
    print_banner
    echo -e "${C_BOLD}>>> 正在检测系统游戏环境...${C_RESET}\n"

    # 1. 显卡状态
    echo -e "${C_PINK}[1] 独立显卡 (GPU) 检测:${C_RESET}"
    if command -v nvidia-smi >/dev/null 2>&1; then
        GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n1 || echo "NVIDIA GPU")
        DRIVER_VER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1 || echo "Unknown")
        GPU_TEMP=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | head -n1 || echo "0")
        echo -e "  ${C_GREEN}✔${C_RESET} 识别到显卡: ${C_BOLD}${GPU_NAME}${C_RESET}"
        echo -e "  ${C_GREEN}✔${C_RESET} 驱动版本: ${DRIVER_VER}"
        echo -e "  ${C_GREEN}✔${C_RESET} 当前核心温度: ${GPU_TEMP}°C"
    else
        echo -e "  ${C_RED}✘${C_RESET} 未检测到 nvidia-smi，请确认 NVIDIA 独显驱动是否安装！"
    fi

    # 2. 核心运行组件
    echo -e "\n${C_BLUE}[2] 核心运行组件检测:${C_RESET}"
    for bin in wine gamescope mangohud steam; do
        if command -v "$bin" >/dev/null 2>&1; then
            VER=$("$bin" --version 2>/dev/null | head -n1 || echo "已就绪")
            echo -e "  ${C_GREEN}✔${C_RESET} ${bin}: ${C_GRAY}${VER}${C_RESET}"
        else
            echo -e "  ${C_YELLOW}⚠${C_RESET} ${bin}: 未安装 (可通过包管理器安装)"
        fi
    done

    # 3. 屏幕与显示服务器
    echo -e "\n${C_PURPLE}[3] 显示环境与刷新率:${C_RESET}"
    echo -e "  ${C_GREEN}✔${C_RESET} 窗口协议: ${XDG_SESSION_TYPE:-Wayland}"
    echo -e "  ${C_GREEN}✔${C_RESET} 屏幕参考配置: 1080p @ 144Hz"

    echo -e "\n${C_GREEN}✔ 环境检测完成。各组件运行状态如上。${C_RESET}\n"
}

cmd_hud_install() {
    print_banner
    HUD_DIR="$HOME/.config/MangoHud"
    HUD_CONF="$HUD_DIR/MangoHud.conf"
    SOURCE_CONF="$(cd "$(dirname "${BASH_SOURCE[0]}")/../configs" && pwd)/MangoHud.conf"

    mkdir -p "$HUD_DIR"
    if [ -f "$HUD_CONF" ]; then
        BACKUP="$HUD_DIR/MangoHud.conf.backup_$(date +%Y%m%d_%H%M%S)"
        echo -e "${C_YELLOW}[!] 备份现有配置至: ${BACKUP}${C_RESET}"
        cp "$HUD_CONF" "$BACKUP"
    fi

    if [ -f "$SOURCE_CONF" ]; then
        cp "$SOURCE_CONF" "$HUD_CONF"
        echo -e "${C_GREEN}[✔] MangoHud 主题配置已安装至: ${HUD_CONF}${C_RESET}"
    else
        echo -e "${C_RED}[✘] 找不到主题源文件: ${SOURCE_CONF}${C_RESET}"
    fi
}

cmd_steam_options() {
    print_banner
    echo -e "${C_BOLD}>>> Steam 启动项参数推荐 (可直接填入游戏属性 -> 启动选项):${C_RESET}\n"
    
    echo -e "${C_CYAN}【方案 A：独显渲染 + 144Hz 锁帧 + FSR 锐化 + 性能监控】:${C_RESET}"
    echo -e "${C_PINK}mangohud __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia gamescope -W 1920 -H 1080 -r 144 --fsr -f -- %command%${C_RESET}\n"

    echo -e "${C_CYAN}【方案 B：纯净独显渲染 + 性能监控】:${C_RESET}"
    echo -e "${C_GREEN}mangohud __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia %command%${C_RESET}\n"

    echo -e "${C_CYAN}【方案 C：仅使用独显渲染 (极简)】:${C_RESET}"
    echo -e "${C_YELLOW}__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia %command%${C_RESET}\n"
}

cmd_run() {
    USE_NVIDIA=1
    USE_GAMESCOPE=0
    USE_HUD=0
    USE_LSFG=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--nvidia)
                USE_NVIDIA=1
                shift
                ;;
            -g|--gamescope)
                USE_GAMESCOPE=1
                shift
                ;;
            -m|--hud)
                USE_HUD=1
                shift
                ;;
            -l|--lsfg)
                USE_LSFG=1
                shift
                ;;
            -*)
                echo -e "${C_RED}未知参数: $1${C_RESET}"
                usage
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -eq 0 ]]; then
        echo -e "${C_RED}错误: 请指定要运行的游戏可执行文件 (.exe) 或命令！${C_RESET}"
        usage
        exit 1
    fi

    TARGET="$1"
    shift

    # 构建启动环境
    if [[ $USE_NVIDIA -eq 1 ]]; then
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
        echo -e "${C_PINK}[★] 已注入 Prime Offload 环境变量 (使用 NVIDIA 独立显卡渲染)${C_RESET}"
    fi

    if [[ $USE_LSFG -eq 1 ]]; then
        export LSFG_PROCESS="miyu"
        echo -e "${C_PURPLE}[★] 已注入: 补帧环境变量${C_RESET}"
    fi

    # 命令拼接
    CMD_WRAP=()
    if [[ $USE_HUD -eq 1 ]]; then
        CMD_WRAP+=("mangohud")
        echo -e "${C_YELLOW}[★] 已挂载: MangoHud 性能监视器${C_RESET}"
    fi

    if [[ $USE_GAMESCOPE -eq 1 ]]; then
        CMD_WRAP+=("gamescope" "-W" "1920" "-H" "1080" "-r" "144" "--fsr" "-f" "--")
        echo -e "${C_BLUE}[★] 已开启: Gamescope (1080p @ 144Hz + FSR 锐化)${C_RESET}"
    fi

    # 判断是否为 Windows .exe
    if [[ "$TARGET" =~ \.exe$ ]] || [[ "$TARGET" =~ \.EXE$ ]]; then
        echo -e "${C_CYAN}[★] 启动 Windows 游戏: $TARGET${C_RESET}"
        exec "${CMD_WRAP[@]}" wine "$TARGET" "$@"
    else
        echo -e "${C_CYAN}[★] 启动目标程序: $TARGET${C_RESET}"
        exec "${CMD_WRAP[@]}" "$TARGET" "$@"
    fi
}

# 顶层路由
case "$1" in
    run)
        shift
        cmd_run "$@"
        ;;
    doctor)
        cmd_doctor
        ;;
    hud-install)
        cmd_hud_install
        ;;
    steam-options)
        cmd_steam_options
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        # 默认如果用户直接输入 `moe-game /path/to/game.exe`
        cmd_run "$@"
        ;;
esac

# 顶层路由
case "$1" in
    run)
        shift
        cmd_run "$@"
        ;;
    doctor)
        cmd_doctor
        ;;
    hud-install)
        cmd_hud_install
        ;;
    steam-options)
        cmd_steam_options
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        # 默认如果用户直接输入 `moe-game /path/to/game.exe`
        cmd_run "$@"
        ;;
esac
